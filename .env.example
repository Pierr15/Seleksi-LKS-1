#--------------------------------------------------------------------
# ORBIT Building — contoh environment (salin ke .env lalu sesuaikan)
#--------------------------------------------------------------------

# Lingkungan aplikasi. Gunakan 'production' untuk pemakaian normal.
# 'development' hanya untuk debugging lokal (menampilkan halaman error detail).
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE (host mengikuti jaringan Docker Compose)
#--------------------------------------------------------------------

database.default.hostname = db
database.default.database = orbit_building
database.default.username = orbit
database.default.password = orbit_pw
database.default.DBDriver = MySQLi
database.default.DBPrefix = ''
database.default.port = 3306

# Database untuk pengujian PHPUnit (dibuat oleh docker/mysql/init).
database.tests.hostname = db
database.tests.database = orbit_building_test
database.tests.username = orbit
database.tests.password = orbit_pw
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = ''
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci
database.tests.port = 3306

#--------------------------------------------------------------------
# KREDENSIAL DATABASE DOCKER (dipakai compose.yaml, bukan aplikasi)
#--------------------------------------------------------------------

MYSQL_ROOT_PASSWORD = orbit_root_pw
MYSQL_DATABASE = orbit_building
MYSQL_USER = orbit
MYSQL_PASSWORD = orbit_pw

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.savePath = null
session.timeToExpire = 7200

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4

#--------------------------------------------------------------------
# BOOTSTRAP ADMIN (dibuat oleh seeder HANYA jika diisi)
# Kosongkan kembali setelah akun admin pertama berhasil dibuat.
#--------------------------------------------------------------------

SEED_ADMIN_NAME =
SEED_ADMIN_EMAIL =
SEED_ADMIN_PASSWORD =

#--------------------------------------------------------------------
# KONFIGURASI SIMULASI ORBIT
#--------------------------------------------------------------------

# Durasi vacant (menit) sebelum aturan otomatisasi dianggap jatuh tempo.
orbit.vacantDurationMinutes = 5

